{
  "name": "guseo-github-pages-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "github:contributions": "node scripts/fetch-github-contributions.mjs",
    "build": "astro build && node scripts/audit-images.mjs",
    "deploy:meta": "node scripts/write-deploy-meta.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "content:check": "node scripts/check-tag-metadata.mjs && node scripts/check-content.mjs && node scripts/check-content-style.mjs",
    "content:style": "node scripts/check-content-style.mjs",
    "links:check": "node scripts/check-links.mjs",
    "test": "node scripts/check-korea-date.mjs && node scripts/check-blog-contracts.mjs && node scripts/content-style-rules.test.mjs",
    "quality:install": "npm install --no-save --package-lock=false @playwright/test@1.61.1 @axe-core/playwright@4.12.1 @lhci/cli@0.15.x",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "smoke": "node scripts/smoke-test.mjs",
    "images:audit": "node scripts/audit-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.3.8",
    "remark-github-blockquote-alert": "^2.1.0",
    "sharp": "^0.34.5",
    "simple-icons": "^16.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
