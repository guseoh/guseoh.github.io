---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import PostCard from "../../components/PostCard.astro";
import { buildCategorySummary, filterPostsByCategory } from "../../utils/categories";
import { getPublishedPosts } from "../../utils/content/posts";
import { getNavigationItemsByType } from "../../utils/navigation";
import { getLearningPathPosts } from "../../utils/postNavigation";
import { SITE_DESCRIPTION, getPostPath, sortPostsByDate } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const summary = new Map<string, { slug: string; name: string; count: number }>();

  for (const item of getNavigationItemsByType("category")) {
    if (!item.slug) continue;
    summary.set(item.slug, { slug: item.slug, name: item.title, count: 0 });
  }

  for (const entry of buildCategorySummary(posts)) {
    summary.set(entry.slug, entry);
  }

  return Array.from(summary.values()).map(({ slug, name }) => ({
    params: { category: slug },
    props: {
      categorySlug: slug,
      categoryName: name,
      posts: sortPostsByDate(filterPostsByCategory(posts, slug))
    }
  }));
}

const { categorySlug, categoryName, posts } = Astro.props as {
  categorySlug: string;
  categoryName: string;
  posts: CollectionEntry<"blog">[];
};

const allPosts = await getPublishedPosts();
const visibleCategorySummary = new Map<string, { slug: string; name: string; count: number }>();

for (const item of getNavigationItemsByType("category")) {
  if (!item.slug) continue;
  visibleCategorySummary.set(item.slug, { slug: item.slug, name: item.title, count: 0 });
}

for (const entry of buildCategorySummary(allPosts)) {
  visibleCategorySummary.set(entry.slug, entry);
}

const categorySummary = Array.from(visibleCategorySummary.values()).filter(({ count }) => count > 0);
// 상세 화면 Learning Path와 동일한 chapter 규칙을 따릅니다.
// chapter가 충돌하면 임의로 순서를 생성하지 않습니다.
const readingPathCandidate = posts.find(
  (post) => !post.data.series && typeof post.data.chapter === "number"
);
const readingPath = readingPathCandidate
  ? getLearningPathPosts(posts, readingPathCandidate)
  : [];
---

<BaseLayout title={`devjune.dev | ${categoryName}`} description={`${categoryName} 카테고리 글 목록 - ${SITE_DESCRIPTION}`}>
  <section class="hero">
    <h1>{categoryName}</h1>
    <p>{posts.length > 0 ? `${posts.length}개의 게시글이 이 카테고리에 연결되어 있습니다.` : "이 카테고리에는 아직 공개된 글이 없습니다."}</p>
  </section>

  <nav class="archive-filter-list" aria-label="카테고리 선택">
    {categorySummary.map(({ slug, name, count }) => (
      <a class:list={["archive-filter-pill", categorySlug === slug && "is-active"]} href={`/categories/${slug}/`} aria-current={categorySlug === slug ? "page" : undefined}>
        <CategoryIcon category={name} />
        <span>{name}</span>
        <strong>{count}</strong>
      </a>
    ))}
  </nav>

  {readingPath.length > 1 && (
    <section class="category-reading-path" aria-labelledby="category-reading-path-title">
      <div class="category-reading-path__head">
        <div>
          <h2 id="category-reading-path-title">이 주제 처음부터 읽기</h2>
          <p>게시글에 지정된 학습 순서대로 이어서 읽을 수 있습니다.</p>
        </div>
        <a class="category-reading-path__start" href={getPostPath(readingPath[0])}>첫 글부터 읽기 <span aria-hidden="true">→</span></a>
      </div>
      <ol class="category-reading-path__list">
        {readingPath.map((post, index) => (
          <li>
            <span class="category-reading-path__step" aria-hidden="true">{index + 1}</span>
            <a href={getPostPath(post)}>{post.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  )}

  {posts.length > 0 ? (
    <ul class="post-list" style="margin-top: 1rem;">
      {posts.map((post) => (
        <li>
          <PostCard post={post} variant="updated" />
        </li>
      ))}
    </ul>
  ) : (
    <p class="section-empty archive-empty">아직 등록된 게시글이 없습니다. <a href="/categories/">다른 카테고리 보기</a></p>
  )}
</BaseLayout>
