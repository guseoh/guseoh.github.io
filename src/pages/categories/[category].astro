---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import PostCard from "../../components/PostCard.astro";
import { buildCategorySummary, filterPostsByCategory } from "../../utils/categories";
import { getPublishedPosts } from "../../utils/content/posts";
import { getNavigationItemsByType } from "../../utils/navigation";
import { SITE_DESCRIPTION, sortPostsByDate } from "../../utils/posts";

type CategorySummaryEntry = {
  slug: string;
  name: string;
  count: number;
};

function buildVisibleCategorySummary(posts: CollectionEntry<"blog">[]): CategorySummaryEntry[] {
  const summary = new Map<string, CategorySummaryEntry>();

  for (const item of getNavigationItemsByType("category")) {
    if (!item.slug) continue;
    summary.set(item.slug, { slug: item.slug, name: item.title, count: 0 });
  }

  for (const entry of buildCategorySummary(posts)) {
    summary.set(entry.slug, entry);
  }

  return Array.from(summary.values());
}

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categorySummary = buildVisibleCategorySummary(posts);

  return categorySummary.map(({ slug, name }) => ({
    params: { category: slug },
    props: {
      categorySlug: slug,
      categoryName: name,
      posts: sortPostsByDate(filterPostsByCategory(posts, slug))
    }
  }));
}

const { categorySlug, categoryName, posts } = Astro.props as {
  categorySlug: string;
  categoryName: string;
  posts: CollectionEntry<"blog">[];
};

const allPosts = await getPublishedPosts();
const categorySummary = buildVisibleCategorySummary(allPosts);
---

<BaseLayout title={`devjune.dev | ${categoryName}`} description={`${categoryName} 카테고리 글 목록 - ${SITE_DESCRIPTION}`}>
  <section class="hero">
    <h1>{categoryName}</h1>
    <p>{posts.length}개의 게시글이 이 카테고리에 연결되어 있습니다.</p>
  </section>

  <nav class="archive-filter-list" aria-label="Category filters">
    {categorySummary.map(({ slug, name, count }) => (
      <a class:list={["archive-filter-pill", categorySlug === slug && "is-active"]} href={`/categories/${slug}/`}>
        <CategoryIcon category={name} />
        <span>{name}</span>
        <strong>{count}</strong>
      </a>
    ))}
  </nav>

  {posts.length > 0 ? (
    <ul class="post-list" style="margin-top: 1rem;">
      {posts.map((post) => (
        <li>
          <PostCard post={post} />
        </li>
      ))}
    </ul>
  ) : (
    <p class="section-empty archive-empty">아직 등록된 게시글이 없습니다.</p>
  )}
</BaseLayout>
