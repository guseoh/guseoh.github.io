---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE_DESCRIPTION } from "../utils/posts";
import navigationData from "../data/navigation.json";

const navigationGroupsJson = JSON.stringify(navigationData);
---

<BaseLayout title="devjune.dev | 검색" description={`검색과 필터 - ${SITE_DESCRIPTION}`}>
  <section class="hero search-hero">
    <h1>검색</h1>
    <p id="search-status" role="status" aria-live="polite" aria-atomic="true">검색 데이터를 불러오는 중입니다.</p>

    <form class="search-page-form" action="/search/" method="get" role="search" data-search-form aria-busy="true">
      <label class="sr-only" for="search-page-input">검색어</label>
      <input id="search-page-input" name="q" type="search" placeholder="예: JPA, Spring Security, Flyway" autocomplete="off" />

      <label class="sr-only" for="search-category-filter">카테고리</label>
      <select id="search-category-filter" name="category" data-search-category>
        <option value="">전체 카테고리</option>
      </select>

      <label class="sr-only" for="search-tag-filter">태그</label>
      <select id="search-tag-filter" name="tag" data-search-tag>
        <option value="">전체 태그</option>
      </select>

      <button type="submit">검색</button>
      <a class="search-reset-link" href="/search/">초기화</a>
    </form>
  </section>

  <section class="search-recent" data-search-recent hidden aria-label="최근 검색어">
    <div class="search-recent__head">
      <h2>최근 검색어</h2>
      <button type="button" data-search-recent-clear>전체 삭제</button>
    </div>
    <div class="search-recent__list" data-search-recent-list></div>
  </section>

  <div class="search-results-meta" data-search-meta role="status" aria-live="polite" hidden></div>
  <ul class="post-list search-results" data-search-list aria-live="polite"></ul>
  <section class="section-empty search-empty" data-search-empty role="region" aria-label="검색 결과 없음" aria-live="polite" aria-atomic="true" hidden>
    <h2 class="search-empty__title">조건에 맞는 글이 없습니다.</h2>
    <p class="search-empty__description">검색어를 바꾸거나 필터를 초기화해 보세요.</p>
    <div class="search-empty__actions">
      <a href="/search/">조건 초기화</a>
      <a href="/categories/">카테고리별 탐색</a>
      <a href="/tags/">태그별 탐색</a>
    </div>
  </section>
  <script is:inline id="search-navigation-groups" type="application/json" set:html={navigationGroupsJson}></script>

  <script>
    import "../scripts/search";
  </script>
</BaseLayout>
