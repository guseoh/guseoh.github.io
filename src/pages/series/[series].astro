---
// Book/Series presentation is loaded only on library routes.
import "../../styles/library.css";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategoryName } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/content/posts";
import { getNavigationItemsByType } from "../../utils/navigation";
import {
  buildSeriesSummary,
  getSeriesMetadata,
  type SeriesStatus
} from "../../utils/series";
import { formatPostDate, getPostDescription, getPostPath, SITE_DESCRIPTION } from "../../utils/posts";

type SeriesPageEntry = {
  id: string;
  title: string;
  description: string;
  status: SeriesStatus;
  category: string;
  latestDate?: Date;
  posts: CollectionEntry<"blog">[];
};

export async function getStaticPaths() {
  const posts = await getPublishedPostsSorted();
  const summary = new Map<string, SeriesPageEntry>();

  for (const item of getNavigationItemsByType("series")) {
    if (!item.slug) continue;
    const metadata = getSeriesMetadata(item.slug);

    summary.set(item.slug, {
      id: item.slug,
      title: metadata?.title ?? item.title,
      description: metadata?.description ?? item.description ?? `${item.title} 시리즈 글을 모아둔 목록입니다.`,
      status: metadata?.status ?? "planned",
      category: "",
      posts: []
    });
  }

  for (const entry of buildSeriesSummary(posts)) {
    summary.set(entry.id, {
      id: entry.id,
      title: entry.title,
      description: entry.description,
      status: entry.status,
      category: entry.category,
      latestDate: entry.latestDate,
      posts: entry.posts
    });
  }

  return Array.from(summary.values()).map((series) => ({
    params: { series: series.id },
    props: series
  }));
}

const { title: seriesName, description, status, category, latestDate, posts } = Astro.props as SeriesPageEntry;
const statusLabel: Record<SeriesStatus, string> = {
  planned: "예정",
  ongoing: "진행 중",
  completed: "완료"
};
---

<BaseLayout title={`devjune.dev | ${seriesName}`} description={`${description} - ${SITE_DESCRIPTION}`}>
  <div class="library-page">
    <section class="hero library-hero">
      <p class="library-hero__eyebrow">{category ? `Series · ${category}` : "Series"}</p>
      <h1>{seriesName}</h1>
      <p>{description}</p>
      <dl class="library-summary">
        <div>
          <dt>Status</dt>
          <dd>{statusLabel[status]}</dd>
        </div>
        <div>
          <dt>Posts</dt>
          <dd>{posts.length}</dd>
        </div>
        {latestDate && (
          <div>
            <dt>Updated</dt>
            <dd>{formatPostDate(latestDate)}</dd>
          </div>
        )}
      </dl>
    </section>

    {posts.length > 0 && (
      <nav class="series-study-status" data-series-study-status aria-label="시리즈 이어 읽기">
        <p>이 시리즈의 전체 {posts.length}개 글은 기존 chapter 순서대로 표시됩니다.</p>
        <a data-series-resume-link href={getPostPath(posts[0])}>첫 글부터 읽기</a>
        <span data-series-resume-note aria-live="polite"></span>
      </nav>
    )}
    <section class="chapter-section" aria-labelledby="series-posts-title">
      <div class="chapter-section__head">
        <div>
          <p class="library-hero__eyebrow">Reading order</p>
          <h2 id="series-posts-title">Posts</h2>
        </div>
        <span>{posts.length}개의 글</span>
      </div>

      {posts.length > 0 ? (
        <ol class="chapter-list">
          {posts.map((post, index) => (
            <li>
              <a href={getPostPath(post)} data-series-post-url={getPostPath(post)}>
                <span class="chapter-list__number">{String(index + 1).padStart(2, "0")}</span>
                <span class="chapter-list__content">
                  <strong>{post.data.title}</strong>
                  <span>{getPostDescription(post)}</span>
                </span>
                <span class="chapter-list__meta">
                  <span>{getCategoryName(post)}</span>
                  <time datetime={(post.data.updated ?? post.data.date).toISOString()}>
                    {formatPostDate(post.data.updated ?? post.data.date)}
                  </time>
                </span>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="section-empty archive-empty">아직 등록된 게시글이 없습니다.</p>
      )}
    </section>
  </div>
  <script is:inline>
    (() => {
      const status = document.querySelector("[data-series-study-status]");
      const link = status?.querySelector("[data-series-resume-link]");
      const note = status?.querySelector("[data-series-resume-note]");
      const entries = Array.from(document.querySelectorAll("[data-series-post-url]"));
      if (!(link instanceof HTMLAnchorElement) || !(note instanceof HTMLElement)) return;
      try {
        const recent = JSON.parse(localStorage.getItem("guseo:reading:last") || "null");
        const current = entries.find((entry) => entry.getAttribute("href") === recent?.url);
        const valid = recent && current && Number.isFinite(recent.fraction)
          && recent.fraction >= 0.08 && recent.fraction < 0.97
          && Number.isFinite(recent.updatedAt)
          && recent.updatedAt <= Date.now()
          && recent.updatedAt > Date.now() - 30 * 24 * 60 * 60 * 1000;
        if (!valid) return;
        link.href = recent.url;
        link.textContent = "최근 읽던 글 이어 읽기";
        note.textContent = "약 " + Math.round(recent.fraction * 100) + "% 읽던 위치";
      } catch {
        // Private mode and disabled storage must not interrupt reading.
      }
    })();
  </script>
</BaseLayout>
