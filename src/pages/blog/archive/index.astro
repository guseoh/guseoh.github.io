---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getPublishedPostsSorted } from "../../../utils/content/posts";
import { buildPublicationArchive } from "../../../utils/publicationArchive";
import { getKoreaDateKey } from "../../../utils/koreaDate";
import { getPostPath, SITE_DESCRIPTION } from "../../../utils/posts";

const years = buildPublicationArchive(await getPublishedPostsSorted());
const total = years.reduce((sum, year) => sum + year.count, 0);
---

<BaseLayout title="devjune.dev | 발행 아카이브" description={"연도·월별 최초 발행 기록 - " + SITE_DESCRIPTION}>
  <section class="blog-list-page" aria-label="발행 연도별 글 아카이브">
    <div class="blog-list-head">
      <div>
        <h1 class="blog-list-head__title">발행 아카이브 ({total})</h1>
        <p class="blog-list-head__description">최초 발행일을 서울 시간 기준 연도·월로 모았습니다. 최근 수정 순서는 <a href="/blog/">전체 글</a>에서 확인할 수 있습니다.</p>
      </div>
    </div>
    {years.length > 0 ? years.map((year) => (
      <section aria-label={year.year + "년 발행 글"}>
        <h2>{year.year}년 · {year.count}개 글</h2>
        {year.months.map((month, index) => (
          <details class="archive-entry" open={index === 0}>
            <summary>{month.title} · {month.posts.length}개</summary>
            <ul>
              {month.posts.map((post) => (
                <li>
                  <time datetime={getKoreaDateKey(post.data.date)}>{getKoreaDateKey(post.data.date)}</time>
                  <a href={getPostPath(post)}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </section>
    )) : <p class="section-empty">발행된 글이 없습니다.</p>}
  </section>
</BaseLayout>
