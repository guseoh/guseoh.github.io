---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import PostViewSwitch from "../../components/PostViewSwitch.astro";
import Pagination from "../../components/Pagination.astro";
import { getPublishedPostsSorted } from "../../utils/content/posts";
import { getPostSlug, POSTS_PER_PAGE, SITE_DESCRIPTION } from "../../utils/posts";
import { getPageCount, getPageItems } from "../../utils/pagination";

const posts = await getPublishedPostsSorted();

const pagePosts = getPageItems(posts, 1, POSTS_PER_PAGE);
const totalPages = getPageCount(posts.length, POSTS_PER_PAGE);
---

<BaseLayout title="devjune.dev | 글" description={SITE_DESCRIPTION}>
  <section
    class="blog-list-page"
    aria-label="전체 게시글"
    data-published-post-count={posts.length}
    data-latest-post-slug={posts[0] ? getPostSlug(posts[0]) : ""}
  >
    <div class="blog-list-head">
      <div>
        <h1 class="blog-list-head__title">전체 글 ({posts.length})</h1>
        <p class="blog-list-head__description">{SITE_DESCRIPTION}</p>
        <p class="blog-list-head__sort">정렬 기준: 최근 수정일순</p>
        <a class="blog-archive-link" href="/blog/archive/">연도·월별 발행 아카이브 보기</a>
      </div>

      <PostViewSwitch listId="blog-post-list" storageKey="guseo:blog-list-view" />
    </div>

    <ul id="blog-post-list" class="post-list post-list--switch" data-post-list>
      {pagePosts.map((post) => (
        <li>
          <PostCard post={post} variant="updated" />
        </li>
      ))}
    </ul>

    <Pagination currentPage={1} totalPages={totalPages} basePath="/blog" />
  </section>
</BaseLayout>

