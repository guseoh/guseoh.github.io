---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import PostViewSwitch from "../../../components/PostViewSwitch.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPublishedPosts } from "../../../utils/content/posts";
import { getPostPath, POSTS_PER_PAGE, SITE_DESCRIPTION } from "../../../utils/posts";

export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || getPostPath(a).localeCompare(getPostPath(b)));
  const totalPages = Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE));
  return Array.from({ length: totalPages }, (_, index) => ({
    params: { page: index === 0 ? undefined : `page/${index + 1}` },
    props: { posts: posts.slice(index * POSTS_PER_PAGE, (index + 1) * POSTS_PER_PAGE), currentPage: index + 1, totalPages, count: posts.length }
  }));
}
const { posts, currentPage, totalPages, count } = Astro.props as { posts: CollectionEntry<"blog">[]; currentPage: number; totalPages: number; count: number };
---
<BaseLayout title="devjune.dev | 최근 발행 글" description={SITE_DESCRIPTION}>
  <section class="blog-list-page" aria-label="최근 발행 글">
    <div class="blog-list-head">
      <div><h1 class="blog-list-head__title">전체 글 ({count})</h1><p class="blog-list-head__description">{SITE_DESCRIPTION}</p>
        <nav class="blog-sort" aria-label="글 정렬"><a href="/blog/">최근 수정순</a><span aria-current="page">최근 발행순</span><a href="/blog/archive/">발행 아카이브</a></nav>
      </div>
      <PostViewSwitch listId="published-post-list" storageKey="guseo:blog-list-view" />
    </div>
    <ul id="published-post-list" class="post-list post-list--switch" data-post-list>{posts.map((post) => <li><PostCard post={post} /></li>)}</ul>
    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/blog/published" />
  </section>
</BaseLayout>
