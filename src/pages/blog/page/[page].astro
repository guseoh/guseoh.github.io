---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import PostViewSwitch from "../../../components/PostViewSwitch.astro";
import Pagination from "../../../components/Pagination.astro";
import { getPublishedPostsSorted } from "../../../utils/content/posts";
import { POSTS_PER_PAGE, SITE_DESCRIPTION } from "../../../utils/posts";
import { getPageCount, getPageItems } from "../../../utils/pagination";

export async function getStaticPaths() {
  const posts = await getPublishedPostsSorted();

  const totalPages = getPageCount(posts.length, POSTS_PER_PAGE);
  if (totalPages <= 1) return [];

  return Array.from({ length: totalPages - 1 }, (_, index) => {
    const currentPage = index + 2;
    return {
      params: { page: String(currentPage) },
      props: {
        pagePosts: getPageItems(posts, currentPage, POSTS_PER_PAGE),
        currentPage,
        totalPages,
        postCount: posts.length
      }
    };
  });
}

const { pagePosts, currentPage, totalPages, postCount } = Astro.props as {
  pagePosts: CollectionEntry<"blog">[];
  currentPage: number;
  totalPages: number;
  postCount: number;
};
---

<BaseLayout title={`devjune.dev | 전체 글 ${currentPage}페이지`} description={SITE_DESCRIPTION}>
  <section class="blog-list-page" aria-label={`전체 글 ${currentPage}페이지`}>
    <div class="blog-list-head">
      <div>
        <h1 class="blog-list-head__title">전체 글 ({postCount})</h1>
        <p class="blog-list-head__description">{SITE_DESCRIPTION}</p>
        <nav class="blog-sort" aria-label="글 정렬"><span aria-current="page">최근 수정순</span><a href="/blog/published/">최근 발행순</a><a href="/blog/archive/">발행 아카이브</a></nav>
      </div>

      <PostViewSwitch listId={`blog-post-list-${currentPage}`} storageKey="guseo:blog-list-view" />
    </div>

    <ul id={`blog-post-list-${currentPage}`} class="post-list post-list--switch" data-post-list>
      {pagePosts.map((post) => (
        <li>
          <PostCard post={post} variant="updated" />
        </li>
      ))}
    </ul>

    <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/blog" />
  </section>
</BaseLayout>
