---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CategoryIcon from "../../components/CategoryIcon.astro";
import PostComments from "../../components/PostComments.astro";
import PostCodeEnhancer from "../../components/post/PostCodeEnhancer.astro";
import PostHeadingEnhancer from "../../components/post/PostHeadingEnhancer.astro";
import PostImageLightbox from "../../components/post/PostImageLightbox.astro";
import PostLinkCardEnhancer from "../../components/post/PostLinkCardEnhancer.astro";
import PostReadingProgress from "../../components/post/PostReadingProgress.astro";
import PostRelatedPosts from "../../components/post/PostRelatedPosts.astro";
import PostTableEnhancer from "../../components/post/PostTableEnhancer.astro";
import PostToc from "../../components/post/PostToc.astro";
import { SITE } from "../../config/site";
import { normalizeCategory } from "../../utils/categories";
import { getPublishedPostsSorted } from "../../utils/content/posts";
import { getAdjacentPosts, getLearningPathPosts } from "../../utils/postNavigation";
import { buildPostTocHeadings } from "../../utils/postToc";
import { getRelatedPosts } from "../../utils/relatedPosts";
import { getSeriesContinuationMessage, getSeriesMetadata } from "../../utils/series";
import { formatTagName, getTagHref } from "../../utils/tags";
import {
  DETAIL_TAG_LIMIT,
  GITHUB_URL,
  REPOSITORY_URL,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_TITLE,
  getPostAliases,
  getPostCommentKey,
  formatPostDate,
  getPostEditUrl,
  getPostOgImagePath,
  getPostPath,
  getPostDescription,
  getPostSourcePath,
  getPostUrl,
  getPostVerificationDate,
  getReadingTime,
  getPostSlug,
  isPostContentStale,
} from "../../utils/posts";

type BlogStaticPath = {
  params: { slug: string };
  props: {
    post: CollectionEntry<"blog">;
    canonicalPath: string;
    isAlias: boolean;
    aliasPath?: string;
  };
};

export async function getStaticPaths() {
  const posts = await getPublishedPostsSorted();

  return posts.flatMap((post) => {
    const canonicalSlug = getPostSlug(post);
    const canonicalPath = getPostPath(post);
    const entries: BlogStaticPath[] = [{
      params: { slug: canonicalSlug },
      props: { post, canonicalPath, isAlias: false }
    }];

    for (const alias of getPostAliases(post)) {
      entries.push({
        params: { slug: alias.replace(/^\/blog\/|\/$/g, "") },
        props: { post, canonicalPath, isAlias: true, aliasPath: alias }
      });
    }

    return entries;
  });
}

const { post, canonicalPath, isAlias = false, aliasPath } = Astro.props as {
  post: CollectionEntry<"blog">;
  canonicalPath: string;
  isAlias?: boolean;
  aliasPath?: string;
};
const { Content, headings } = await render(post);
const allPosts = await getPublishedPostsSorted();
const categoryName = post.data.category?.trim() || "Uncategorized";
const categorySlug = normalizeCategory(categoryName);
const postTitle = post.data.title.trim();
const tocHeadings = buildPostTocHeadings(headings, postTitle);
const readingTime = getReadingTime(post);
const description = getPostDescription(post);
const visibleTags = post.data.tags.slice(0, DETAIL_TAG_LIMIT);
const hiddenTagCount = Math.max(0, post.data.tags.length - visibleTags.length);
const seriesName = post.data.series?.trim();
const seriesMetadata = seriesName ? getSeriesMetadata(seriesName) : undefined;
const seriesTitle = seriesMetadata?.title ?? seriesName;
const seriesContinuationMessage = seriesName ? getSeriesContinuationMessage(seriesName) : "";
// Look up the canonical collection entry when the current post is delivered
// through getStaticPaths props. This keeps Learning Path chapter metadata in
// sync with the published collection used by the category page.
const canonicalLearningPost = allPosts.find((entry) => getPostSlug(entry) === getPostSlug(post)) ?? post;
const learningPathPosts = getLearningPathPosts(allPosts, canonicalLearningPost);
const learningPathIndex = learningPathPosts.findIndex((entry) => entry.id === post.id);
const learningPathTitle = seriesTitle ?? `${categoryName} 학습 경로`;
const showLearningPath = Boolean(seriesName) || learningPathPosts.length > 1;
const previousLearningPost = learningPathIndex > 0 ? learningPathPosts[learningPathIndex - 1] : undefined;
const nextLearningPost = learningPathIndex >= 0 && learningPathIndex < learningPathPosts.length - 1
  ? learningPathPosts[learningPathIndex + 1]
  : undefined;
const { newerPost, olderPost } = getAdjacentPosts(allPosts, post.id);
// A learning-path entry should not also appear as a related-post recommendation.
const learningPathPostIds = new Set(learningPathPosts.map((entry) => entry.id));
const relatedCandidates = allPosts.filter((entry) => !learningPathPostIds.has(entry.id));
const relatedPosts = getRelatedPosts(post, relatedCandidates, { limit: 3 });
const siteUrl = Astro.site ?? new URL(SITE.siteUrl);
const postUrl = getPostUrl(post, siteUrl);
const postImagePath = getPostOgImagePath(post);
const postImage = new URL(postImagePath, siteUrl).toString();
const verificationDate = getPostVerificationDate(post);
const isStalePost = isPostContentStale(post);
const commentKey = getPostCommentKey(post);
const sourcePath = getPostSourcePath(post);
const showEditLink = import.meta.env.DEV;
const editUrl = showEditLink ? getPostEditUrl(post) : "";
const deployedSha = import.meta.env.GITHUB_SHA || "local-preview";
const issueUrl = new URL(`${REPOSITORY_URL}/issues/new`);
issueUrl.searchParams.set("template", "content-error.yml");
issueUrl.searchParams.set("title", `[Content] ${postTitle}`);
issueUrl.searchParams.set("body", [
  "## 게시글",
  postTitle,
  "",
  "## URL",
  postUrl,
  "",
  "## Markdown 파일",
  sourcePath,
  "",
  "## 배포 커밋",
  deployedSha,
  "",
  "## 오류가 있는 내용 또는 문단",
  "",
  "## 제안하는 수정 방향",
  ""
].join("\n"));
const testedWithEntries = Object.entries(post.data.testedWith ?? {});
const postStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl
  },
  url: postUrl,
  author: {
    "@type": "Person",
    name: SITE_AUTHOR,
    url: GITHUB_URL
  },
  publisher: {
    "@type": "Organization",
    name: SITE_TITLE
  },
  image: postImage,
  articleSection: categoryName,
  keywords: post.data.tags.length > 0 ? post.data.tags : undefined
};
const breadcrumbStructuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.siteUrl },
    { "@type": "ListItem", position: 2, name: categoryName, item: new URL(`/categories/${categorySlug}/`, siteUrl).toString() },
    { "@type": "ListItem", position: 3, name: postTitle, item: postUrl }
  ]
};
---

{isAlias ? (
  <BaseLayout
    title={`${post.data.title} | devjune.dev`}
    description={description || SITE_DESCRIPTION}
    image={postImagePath}
    type="article"
    canonicalUrl={canonicalPath}
    refreshUrl={canonicalPath}
    currentCategory={post.data.category}
    robots="noindex,follow"
  >
    <section class="hero post-alias-notice" aria-labelledby="alias-title">
      <p class="library-hero__eyebrow">Moved</p>
      <h1 id="alias-title">게시글 주소가 변경되었습니다.</h1>
      <p>
        이 주소{aliasPath ? `(${aliasPath})` : ""}는 이전 게시글 경로입니다.
        새 주소로 이동해 주세요.
      </p>
      <a href={canonicalPath}>새 주소로 이동</a>
    </section>
  </BaseLayout>
) : (
<BaseLayout
  title={`${post.data.title} | devjune.dev`}
  description={description || SITE_DESCRIPTION}
  image={postImagePath}
  publishedTime={post.data.date.toISOString()}
  updatedTime={(post.data.updated ?? post.data.date).toISOString()}
  type="article"
  wideContent={true}
  structuredData={[postStructuredData, breadcrumbStructuredData]}
  currentCategory={post.data.category}
  canonicalUrl={canonicalPath}
>
  <PostReadingProgress />

  <div class:list={["post-view", tocHeadings.length === 0 && "post-view--single"]}>
    <PostToc headings={tocHeadings} />

    <div class="post-column">
    <article class="post">
      <header class="post__header">
        <h1>{post.data.title}</h1>
        <p class="post__description">{description}</p>

        <dl class="post-meta-grid post-meta-grid--compact" aria-label="게시글 정보">
          <div class="post-meta-item">
            <dt class="sr-only">작성일</dt>
            <dd><time datetime={post.data.date.toISOString()}>{formatPostDate(post.data.date)}</time></dd>
          </div>
          {post.data.updated && post.data.updated.valueOf() !== post.data.date.valueOf() && (
            <div class="post-meta-item">
              <dt class="sr-only">수정일</dt>
              <dd>수정 <time datetime={post.data.updated.toISOString()}>{formatPostDate(post.data.updated)}</time></dd>
            </div>
          )}
          {post.data.lastVerified && post.data.lastVerified.valueOf() !== (post.data.updated ?? post.data.date).valueOf() && (
            <div class="post-meta-item post-meta-item--verification">
              <dt class="sr-only">마지막 검증</dt>
              <dd>검증 <time datetime={post.data.lastVerified.toISOString()}>{formatPostDate(post.data.lastVerified)}</time></dd>
            </div>
          )}
          <div class="post-meta-item">
            <dt class="sr-only">카테고리</dt>
            <dd>
              <a class="tag tag--category" href={`/categories/${categorySlug}/`}>
                <CategoryIcon category={categoryName} />
                <span>{categoryName}</span>
              </a>
            </dd>
          </div>
          <div class="post-meta-item">
            <dt class="sr-only">읽는 시간</dt>
            <dd>{readingTime}</dd>
          </div>
        </dl>

        {testedWithEntries.length > 0 && (
          <div class="post-tested-with" aria-label="검증 환경">
            <strong>검증 환경</strong>
            <span>{testedWithEntries.map(([name, version]) => `${name} ${version}`).join(" · ")}</span>
          </div>
        )}

        {post.data.tags.length > 0 && (
          <div class="post-meta-tags" aria-label="Post tags">
            {visibleTags.map((tag) => (
              <a class="tag" href={getTagHref(tag)}>#{formatTagName(tag)}</a>
            ))}
            {hiddenTagCount > 0 && <span class="tag tag--muted">+{hiddenTagCount} tags</span>}
          </div>
        )}
      </header>

      <aside class="post-reading-resume" data-reading-resume hidden aria-label="이어 읽기">
        <p><strong>이어서 읽기</strong> <span data-reading-resume-label></span><small>이 브라우저에만 기록됩니다.</small></p>
        <div class="post-reading-resume__actions">
          <button type="button" data-reading-resume-action>저장한 위치로</button>
          <button type="button" data-reading-resume-clear>기록 삭제</button>
        </div>
      </aside>

      {isStalePost && (
        <aside class="post-freshness-note" aria-label="게시글 검증 안내">
          <strong>검증 안내</strong>
          <p>
            이 글은 마지막 검증 후 1년 이상 지났습니다. 일부 내용이 현재 버전과 다를 수 있습니다.
            <span> 마지막 기준일: <time datetime={verificationDate.toISOString()}>{formatPostDate(verificationDate)}</time></span>
          </p>
        </aside>
      )}

      <div class="post__content">
        <Content />
      </div>

      <footer class="post-footer">
        {showLearningPath && learningPathTitle && (
          <section class="post-series post-learning-path" aria-label="Learning path">
            <div class="post-learning-path__head">
              <div>
                <p class="post-series__label">Learning Path</p>
                <h2>
                  {seriesMetadata ? <a href={`/series/${seriesMetadata.id}/`}>{learningPathTitle}</a> : learningPathTitle}
                </h2>
              </div>
              {learningPathIndex >= 0 && learningPathPosts.length > 0 && (
                <span>{learningPathIndex + 1} / {learningPathPosts.length}</span>
              )}
            </div>

            {learningPathPosts.length > 1 ? (
              <ol class="post-series__list">
                {learningPathPosts.map((learningPost) => (
                  <li class:list={[learningPost.id === post.id && "is-current"]}>
                    {learningPost.id === post.id ? (
                      <span>{learningPost.data.title}</span>
                    ) : (
                      <a href={getPostPath(learningPost)}>{learningPost.data.title}</a>
                    )}
                  </li>
                ))}
              </ol>
            ) : (
              <p class="post-series__empty">{seriesContinuationMessage}</p>
            )}

            {learningPathPosts.length > 3 && (previousLearningPost || nextLearningPost) && (
              <nav class="post-learning-path__nav" aria-label="학습 경로 이전과 다음 글">
                {previousLearningPost ? (
                  <a href={getPostPath(previousLearningPost)}>
                    <span>이전 단계</span>
                    <strong>{previousLearningPost.data.title}</strong>
                  </a>
                ) : <span></span>}
                {nextLearningPost ? (
                  <a class="post-learning-path__next" href={getPostPath(nextLearningPost)}>
                    <span>다음 단계</span>
                    <strong>{nextLearningPost.data.title}</strong>
                  </a>
                ) : <span></span>}
              </nav>
            )}
          </section>
        )}

        <PostRelatedPosts relatedPosts={relatedPosts} />

        <nav class="post-adjacent" aria-label="Previous and next posts">
          {olderPost ? (
            <a class="post-adjacent__card" href={getPostPath(olderPost)}>
              <span>이전 글</span>
              <strong>{olderPost.data.title}</strong>
            </a>
          ) : (
            <span class="post-adjacent__card post-adjacent__card--empty">이전 글이 없습니다.</span>
          )}

          {newerPost ? (
            <a class="post-adjacent__card post-adjacent__card--next" href={getPostPath(newerPost)}>
              <span>다음 글</span>
              <strong>{newerPost.data.title}</strong>
            </a>
          ) : (
            <span class="post-adjacent__card post-adjacent__card--empty post-adjacent__card--next">다음 글이 없습니다.</span>
          )}
        </nav>

        <section class="post-feedback" aria-labelledby="post-feedback-title">
          <h2 id="post-feedback-title">이 글 개선하기</h2>
          <div class="post-feedback__actions">
            {showEditLink && editUrl && (
              <a href={editUrl} target="_blank" rel="noopener noreferrer" aria-label={`${postTitle} Markdown 파일을 GitHub에서 수정하기`}>
                GitHub에서 이 글 수정하기
              </a>
            )}
            <a href={issueUrl.toString()} target="_blank" rel="noopener noreferrer" aria-label={`${postTitle} 내용 오류를 GitHub Issue로 신고하기`}>
              내용 오류 신고하기
            </a>
          </div>
        </section>
      </footer>
    </article>
    <PostComments commentKey={commentKey} postUrl={postUrl} />
    </div>
  </div>

  <PostImageLightbox />
  <PostLinkCardEnhancer />
  <PostHeadingEnhancer />
  <PostTableEnhancer />
  <PostCodeEnhancer />
</BaseLayout>
)}
