---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROJECTS, type Project } from "../../data/projects";
import { SITE_AUTHOR, SITE_URL } from "../../utils/posts";

export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props as { project: Project };
const projectUrl = `${SITE_URL}/projects/${project.slug}/`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.name,
    description: project.summary,
    url: projectUrl,
    creator: {
      "@type": "Person",
      name: SITE_AUTHOR
    },
    codeRepository: project.repositoryUrl,
    keywords: project.tech.join(", ")
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE_URL },
      { "@type": "ListItem", position: 2, name: "Projects", item: `${SITE_URL}/projects/` },
      { "@type": "ListItem", position: 3, name: project.name, item: projectUrl }
    ]
  }
];
---

<BaseLayout
  title={`devjune.dev | ${project.name}`}
  description={project.summary}
  structuredData={structuredData}
  wideContent={true}
>
  <div class="project-page project-detail-page">
    <nav class="project-breadcrumb" aria-label="프로젝트 경로">
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>

    <section class="hero project-detail-hero">
      <div>
        <p class="project-eyebrow">{project.eyebrow}</p>
        <h1>{project.name}</h1>
        <p>{project.summary}</p>
      </div>
      <div class="project-detail-hero__aside">
        <span>현재 상태</span>
        <strong>{project.status}</strong>
        <a href={project.repositoryUrl} target="_blank" rel="noreferrer">GitHub Repository</a>
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="project-problem-title">
      <p class="project-eyebrow">Problem & Direction</p>
      <h2 id="project-problem-title">프로젝트가 해결하려는 문제</h2>
      <p>{project.productDefinition}</p>
    </section>

    <div class="project-detail-grid">
      <section class="project-detail-section" aria-labelledby="project-scope-title">
        <p class="project-eyebrow">Current Scope</p>
        <h2 id="project-scope-title">현재 범위</h2>
        <ul>
          {project.currentScope.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="project-detail-section" aria-labelledby="project-highlight-title">
        <p class="project-eyebrow">Evidence</p>
        <h2 id="project-highlight-title">설계와 검증 포인트</h2>
        <ul>
          {project.highlights.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <section class="project-detail-section" aria-labelledby="project-tech-title">
      <p class="project-eyebrow">Technology</p>
      <h2 id="project-tech-title">기술 구성</h2>
      <div class="project-tech-list project-tech-list--large">
        {project.tech.map((tech) => <span>{tech}</span>)}
      </div>
    </section>

    <section class="project-detail-section" aria-labelledby="project-next-title">
      <p class="project-eyebrow">Next</p>
      <h2 id="project-next-title">다음 단계</h2>
      <ul>
        {project.nextSteps.map((item) => <li>{item}</li>)}
      </ul>
      <div class="project-card__actions project-detail-actions">
        <a href={`/search/?q=${encodeURIComponent(project.relatedQuery)}`}>관련 블로그 글</a>
        <a href={project.repositoryUrl} target="_blank" rel="noreferrer">저장소에서 자세히 보기</a>
      </div>
    </section>
  </div>
</BaseLayout>
