---
import type { CollectionEntry } from "astro:content";
import { getPostDescription, getPostPath, getReadingTime } from "../../utils/posts";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props as Props;
---

{posts.length > 0 && (
  <section class="home-section home-featured-posts" aria-labelledby="home-featured-title">
    <div class="home-section__head">
      <div>
        <p class="home-section__eyebrow">추천 글</p>
        <h2 id="home-featured-title" class="home-section__title">처음 방문했다면</h2>
      </div>
      <p class="home-section__subtitle">처음 읽기 좋은 핵심 개념</p>
    </div>
    <ul class="home-featured-list">
      {posts.map((post) => (
        <li>
          <a class="home-featured-card" href={getPostPath(post)}>
            <span class="home-featured-card__category">{post.data.category}</span>
            <strong>{post.data.title}</strong>
            <span class="home-featured-card__description">{getPostDescription(post)}</span>
            <span class="home-featured-card__footer">{getReadingTime(post)} · 글 읽기 ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
