---
import { PROJECTS } from "../../data/projects";
---

<section class="home-section home-projects" aria-labelledby="home-projects-title">
  <div class="home-section__head">
    <div>
      <p class="home-section__eyebrow">Projects</p>
      <h2 id="home-projects-title" class="home-section__title">현재 프로젝트</h2>
    </div>
    <a class="home-section__link" href="/projects/">전체 프로젝트</a>
  </div>

  <div class="home-project-grid">
    {PROJECTS.map((project) => (
      <article class="project-summary-card">
        <div class="project-summary-card__head">
          <span>{project.eyebrow}</span>
          <small>{project.status}</small>
        </div>
        <h3><a href={`/projects/${project.slug}/`}>{project.name}</a></h3>
        <p>{project.summary}</p>
        <a class="project-summary-card__link" href={`/projects/${project.slug}/`}>사례 보기</a>
      </article>
    ))}
  </div>
</section>
