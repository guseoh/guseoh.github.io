---
import type { CollectionEntry } from "astro:content";
import PostMetaBadges from "./PostMetaBadges.astro";
import { formatPostDate, getPostDescription, getPostPath, getPostSlug, getReadingTime } from "../utils/posts";

interface Props {
  post: CollectionEntry<"blog">;
  variant?: "default" | "latest" | "updated";
  featured?: boolean;
}

const { post, variant = "default", featured = false } = Astro.props as Props;
const isLatest = variant === "latest";
const isUpdated = variant === "updated";
const readingTime = getReadingTime(post);
const description = getPostDescription(post);
const postPath = getPostPath(post);
const postSlug = getPostSlug(post);
const hasMeaningfulUpdate = Boolean(post.data.updated && post.data.updated.valueOf() > post.data.date.valueOf());
const showUpdatedDate = isUpdated && hasMeaningfulUpdate;
const displayDate = showUpdatedDate ? post.data.updated! : post.data.date;
---

<article class:list={["card", "post-card", isLatest && "post-card--latest", isUpdated && "post-card--updated", featured && "post-card--featured"]} data-post-slug={postSlug}>
  {featured && <span class="post-card__eyebrow">최근 발행</span>}
  <header class="post-card__header">
    <h2><a href={postPath}>{post.data.title}</a></h2>
  </header>

  <p class="post-card__description">{description}</p>

  <div class="post-card__footer">
    <div class="post-card__meta">
      <span>{showUpdatedDate ? "수정" : "작성"}</span>
      <time datetime={displayDate.toISOString()}>{formatPostDate(displayDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime}</span>
    </div>

    <PostMetaBadges category={post.data.category} tags={post.data.tags} maxTags={isLatest ? 3 : 4} />
  </div>
</article>
