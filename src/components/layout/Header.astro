---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../../utils/posts";

interface Props {
  currentPath?: string;
  hasPublishedBooks?: boolean;
  hasPublishedSeries?: boolean;
}

const {
  currentPath = "/",
  hasPublishedBooks = false,
  hasPublishedSeries = false
} = Astro.props as Props;

// Primary navigation contains public destinations with content. Individual
// topics remain in the sidebar; empty library pages retain their routes.
const navItems = [
  { href: "/blog/", label: "글" },
  { href: "/categories/", label: "카테고리" },
  { href: "/tags/", label: "태그" },
  ...(hasPublishedBooks ? [{ href: "/books/", label: "책" }] : []),
  ...(hasPublishedSeries ? [{ href: "/series/", label: "연재" }] : []),
  { href: "/about/", label: "소개" },
  { href: "/search/", label: "검색" }
];

function isActive(href: string) {
  const normalizedHref = href === "/" ? "/" : href.replace(/\/+$/, "");
  if (normalizedHref === "/") return currentPath === "/";

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE_TITLE} 홈으로 이동`}>{SITE_TITLE}</a>

    <div class="header-actions">
      <button
        id="header-menu-toggle"
        class="header-menu-toggle"
        type="button"
        aria-label="메인 메뉴 열기"
        aria-controls="top-nav"
        aria-expanded="false"
      >
        <span class="header-menu-toggle__line"></span>
        <span class="header-menu-toggle__line"></span>
        <span class="header-menu-toggle__line"></span>
      </button>

      <nav id="top-nav" class="top-nav" aria-label="주요 메뉴">
        {
          navItems.map(({ href, label }) => (
            <a
              class:list={["top-nav__link", isActive(href) && "is-active"]}
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>
