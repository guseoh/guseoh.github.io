---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../../utils/posts";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props as Props;
const navItems = [
  { href: "/blog/", label: "Posts" },
  { href: "/categories/", label: "Categories" },
  { href: "/tags/", label: "Tags" },
  { href: "/books/", label: "Books" },
  { href: "/series/", label: "Series" },
  { href: "/about/", label: "About" },
  { href: "/search/", label: "Search" }
];

function isActive(href: string) {
  const normalizedHref = href === "/" ? "/" : href.replace(/\/+$/, "");
  if (normalizedHref === "/") return currentPath === "/";

  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE_TITLE} 홈으로 이동`}>{SITE_TITLE}</a>

    <div class="header-actions">
      <button
        id="header-menu-toggle"
        class="header-menu-toggle"
        type="button"
        aria-label="메인 메뉴 열기"
        aria-controls="top-nav"
        aria-expanded="false"
      >
        <span class="header-menu-toggle__line"></span>
        <span class="header-menu-toggle__line"></span>
        <span class="header-menu-toggle__line"></span>
      </button>

      <nav id="top-nav" class="top-nav" aria-label="Primary navigation">
        {
          navItems.map(({ href, label }) => (
            <a
              class:list={["top-nav__link", isActive(href) && "is-active"]}
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>
