---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE_TITLE } from "../../utils/posts";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props as Props;
const navItems = [
  { href: "/blog/", label: "Posts" },
  { href: "/projects/", label: "Projects" },
  { href: "/categories/", label: "Categories" },
  { href: "/tags/", label: "Tags" },
  { href: "/books/", label: "Books" },
  { href: "/series/", label: "Series" },
  { href: "/about/", label: "About" }
];

const isActive = (href: string) => currentPath === href.replace(/\/$/, "") || currentPath.startsWith(href);
---

<header class="site-header" data-site-header>
  <a class="site-brand" href="/" aria-label={`${SITE_TITLE} home`}>
    <span class="site-brand__mark">J</span>
    <span>{SITE_TITLE}</span>
  </a>

  <button
    class="mobile-menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="site-top-nav"
    aria-label="메뉴 열기"
    data-mobile-menu-toggle
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav id="site-top-nav" class="top-nav" aria-label="Primary navigation" data-top-nav>
    {navItems.map((item) => (
      <a class:list={[isActive(item.href) && "is-active"]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="header-actions">
    <a class="header-search-button" href="/search/?focus=1" aria-label="검색 페이지 열기">
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <span>Search</span>
    </a>
    <ThemeToggle />
    <button
      class="mobile-sidebar-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-sidebar"
      aria-label="카테고리 사이드바 열기"
      data-mobile-sidebar-toggle
    >
      <span aria-hidden="true">☰</span>
      <span>Categories</span>
    </button>
  </div>
</header>
