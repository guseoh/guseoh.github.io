<script is:inline>
  (() => {
    const root = document.querySelector(".post__content");
    if (!(root instanceof HTMLElement)) return;

    const textTabs = Array.from(root.querySelectorAll("[data-learning-tabs]"));
    textTabs.forEach((group, groupIndex) => {
      const panels = Array.from(group.querySelectorAll(":scope > [data-learning-panel]"));
      if (panels.length < 2) return;
      const list = document.createElement("div");
      list.className = "learning-tabs__list";
      list.setAttribute("role", "tablist");
      list.setAttribute("aria-label", "설명 내용 선택");
      const buttons = [];
      const activate = (index, focus = false) => {
        panels.forEach((panel, i) => {
          panel.hidden = i !== index;
          buttons[i].setAttribute("aria-selected", String(i === index));
          buttons[i].tabIndex = i === index ? 0 : -1;
        });
        if (focus) buttons[index].focus();
      };
      panels.forEach((panel, i) => {
        const heading = panel.querySelector("h4");
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = heading?.textContent || "탭 " + (i + 1);
        button.id = "learning-tab-" + groupIndex + "-" + i;
        panel.id = "learning-panel-" + groupIndex + "-" + i;
        button.setAttribute("role", "tab");
        button.setAttribute("aria-controls", panel.id);
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", button.id);
        button.addEventListener("click", () => activate(i));
        button.addEventListener("keydown", (event) => {
          let target = -1;
          if (event.key === "ArrowRight") target = (i + 1) % panels.length;
          if (event.key === "ArrowLeft") target = (i - 1 + panels.length) % panels.length;
          if (event.key === "Home") target = 0;
          if (event.key === "End") target = panels.length - 1;
          if (target === -1) return;
          event.preventDefault();
          activate(target, true);
        });
        list.append(button);
        buttons.push(button);
      });
      group.prepend(list);
      group.classList.add("learning-tabs--enhanced");
      activate(0);
    });

    const mathNodes = Array.from(root.querySelectorAll("[data-learning-math]"));
    if (mathNodes.length > 0) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "https://cdn.jsdelivr.net/npm/katex@0.16.25/dist/katex.min.css";
      link.crossOrigin = "anonymous";
      document.head.append(link);
      import("https://cdn.jsdelivr.net/npm/katex@0.16.25/dist/katex.mjs").then((mod) => {
        const katex = mod.default ?? mod;
        mathNodes.forEach((node) => {
          const source = node.getAttribute("data-learning-math") || "";
          try {
            katex.render(source, node, {
              throwOnError: true,
              trust: false,
              strict: "warn",
              displayMode: node.getAttribute("data-math-display") === "true",
              output: "htmlAndMathml"
            });
            node.classList.add("learning-math--rendered");
          } catch {
            node.setAttribute("title", "수식 렌더링 실패: 원본 LaTeX 표시");
          }
        });
      }).catch(() => {
        mathNodes.forEach((node) => node.setAttribute("title", "렌더러를 불러오지 못해 LaTeX 원문을 표시합니다."));
      });
    }

    const diagramNodes = Array.from(root.querySelectorAll("[data-learning-mermaid]"));
    if (diagramNodes.length > 0) {
      let mermaidPromise;
      const getMermaid = () => {
        mermaidPromise ??= import("https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs")
          .then((module) => module.default ?? module);
        return mermaidPromise;
      };
      const renderDiagram = async (node, index) => {
        if (node.dataset.mermaidRendered === "true") return;
        const pre = node.querySelector("[data-learning-mermaid-source]");
        if (!(pre instanceof HTMLElement)) return;
        try {
          const mermaid = await getMermaid();
          const dark = document.documentElement.getAttribute("data-theme") === "dark";
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: "strict",
            theme: dark ? "dark" : "default",
            flowchart: { htmlLabels: false },
            maxTextSize: 12000,
            suppressErrorRendering: true
          });
          const result = await mermaid.render("learn-diagram-" + index, pre.textContent || "");
          const doc = new DOMParser().parseFromString(result.svg, "image/svg+xml");
          const svg = doc.documentElement;
          if (svg.localName.toLowerCase() !== "svg" || svg.namespaceURI !== "http://www.w3.org/2000/svg") {
            throw new Error("Unsafe or invalid diagram result");
          }
          // A browser DOM import would activate non-SVG or fetch-capable nodes.
          // Use a conservative SVG allowlist and retain the visible source on failure.
          const allowedTags = new Set([
            "svg", "g", "defs", "style", "path", "rect", "circle", "ellipse",
            "line", "polyline", "polygon", "text", "tspan", "title", "desc",
            "marker", "lineargradient", "radialgradient", "stop", "clippath"
          ]);
          for (const element of [svg, ...svg.querySelectorAll("*")]) {
            if (element.namespaceURI !== "http://www.w3.org/2000/svg"
              || !allowedTags.has(element.localName.toLowerCase())) {
              throw new Error("Diagram contains an unsupported element");
            }
            for (const attr of Array.from(element.attributes)) {
              const key = attr.localName.toLowerCase();
              const value = attr.value;
              // The SVG namespace is a required XML declaration, not a fetch.
              if (attr.name === "xmlns" && value === "http://www.w3.org/2000/svg") continue;
              if (/^on/i.test(key) || key === "href" || key === "src"
                || key === "externalresourcesrequired" || attr.namespaceURI === "http://www.w3.org/1999/xlink"
                || /url\(\s*['"]?\s*(?:https?:|data:|javascript:|\/\/)/i.test(value)
                || /(?:https?:|javascript:|data:text\/html)/i.test(value)) {
                throw new Error("Diagram contains an unsafe reference");
              }
            }
            if (element.localName.toLowerCase() === "style"
              && /@import|url\s*\(\s*['"]?\s*(?!#)|expression\s*\(/i.test(element.textContent || "")) {
              throw new Error("Diagram contains an unsafe stylesheet");
            }
          }
          const details = document.createElement("details");
          const summary = document.createElement("summary");
          summary.textContent = "다이어그램 원문";
          details.append(summary, pre);
          node.prepend(document.importNode(svg, true));
          node.append(details);
          node.dataset.mermaidRendered = "true";
        } catch {
          node.dataset.mermaidFailed = "true";
          const message = document.createElement("p");
          message.className = "learning-mermaid-fallback";
          message.setAttribute("role", "status");
          message.textContent = "도식을 불러오지 못해 텍스트 원본을 표시합니다.";
          node.prepend(message);
        }
      };
      const observer = "IntersectionObserver" in window
        ? new IntersectionObserver((entries) => {
          entries.filter((entry) => entry.isIntersecting).forEach((entry) => {
            observer.unobserve(entry.target);
            renderDiagram(entry.target, diagramNodes.indexOf(entry.target));
          });
        }, { rootMargin: "250px" })
        : null;
      diagramNodes.forEach((node, index) => {
        if (observer) observer.observe(node);
        else renderDiagram(node, index);
      });
    }

    // User-entered JS/Java is deliberately unsupported; only a bounded,
    // numeric arithmetic expression is evaluated inside a sandboxed frame.
    const runners = Array.from(root.querySelectorAll("[data-learning-run]"));
    runners.forEach((runner, index) => {
      const execute = runner.querySelector("[data-learning-execute]");
      const reset = runner.querySelector("[data-learning-reset]");
      const output = runner.querySelector("[data-learning-output]");
      const expression = runner.querySelector("[data-learning-expression]")?.textContent?.trim() ?? "";
      if (!(execute instanceof HTMLButtonElement) || !(reset instanceof HTMLButtonElement)
        || !(output instanceof HTMLElement)) return;
      let currentFrame = null;
      let cleanup = null;
      const clear = () => {
        cleanup?.();
        cleanup = null;
        currentFrame?.remove();
        currentFrame = null;
      };
      const runnerSource = [
        "<!doctype html><html><head><meta http-equiv=\"Content-Security-Policy\"",
        " content=\"default-src 'none'; script-src 'unsafe-inline'; connect-src 'none'; form-action 'none'\">",
        "</head><body><script>",
        "function calculate(source){",
        "let input=source.replace(/\\s+/g,''), tokens=input.match(/\\d+(?:\\.\\d+)?|[()+*/%-]/g)||[];",
        "if(tokens.join('')!==input)throw Error('Invalid token');",
        "let i=0;function primary(){let t=tokens[i++];if(t==='+'||t==='-'){let n=primary();return t==='-'?-n:n;}",
        "if(t==='('){let n=sum();if(tokens[i++]!==')')throw Error('Missing )');return n;}",
        "if(!t||!/^\\d/.test(t))throw Error('Expected number');return Number(t);}",
        "function product(){let n=primary();while(['*','/','%'].includes(tokens[i])){",
        "let op=tokens[i++],v=primary();n=op==='*'?n*v:op==='/'?n/v:n%v;}return n;}",
        "function sum(){let n=product();while(['+','-'].includes(tokens[i])){",
        "let op=tokens[i++],v=product();n=op==='+'?n+v:n-v;}return n;}",
        "let result=sum();if(i!==tokens.length||!Number.isFinite(result))throw Error('Invalid expression');",
        "return result;}",
        "addEventListener('message',function(e){",
        "if(!e.data||e.data.type!=='calculate')return;",
        "try{parent.postMessage({type:'calculated',id:e.data.id,value:String(calculate(e.data.expression))},'*');}",
        "catch(err){parent.postMessage({type:'calculated',id:e.data.id,error:'표현식을 계산할 수 없습니다.'},'*');}});",
        "</scr" + "ipt></body></html>"
      ].join("");
      execute.addEventListener("click", () => {
        clear();
        output.textContent = "계산 중…";
        const frame = document.createElement("iframe");
        frame.hidden = true;
        frame.tabIndex = -1;
        frame.setAttribute("aria-hidden", "true");
        frame.setAttribute("sandbox", "allow-scripts");
        frame.setAttribute("referrerpolicy", "no-referrer");
        currentFrame = frame;
        const id = "learn-run-" + index + "-" + Date.now();
        const onMessage = (event) => {
          if (event.source !== frame.contentWindow || event.data?.type !== "calculated" || event.data.id !== id) return;
          output.textContent = event.data.error ?? "결과: " + event.data.value;
          clear();
        };
        window.addEventListener("message", onMessage);
        const timeout = window.setTimeout(() => {
          output.textContent = "실행 시간이 초과되었습니다.";
          clear();
        }, 3000);
        cleanup = () => {
          window.removeEventListener("message", onMessage);
          window.clearTimeout(timeout);
        };
        frame.addEventListener("load", () => {
          frame.contentWindow?.postMessage({ type: "calculate", id, expression }, "*");
        }, { once: true });
        frame.srcdoc = runnerSource;
        runner.append(frame);
      });
      reset.addEventListener("click", () => {
        clear();
        output.textContent = "실행 전";
      });
    });
  })();
</script>
