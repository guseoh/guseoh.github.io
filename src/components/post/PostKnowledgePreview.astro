---
import type { PreviewEntry } from "../../utils/postRelations";
interface Props { entries: PreviewEntry[]; }
const { entries } = Astro.props as Props;
---
<div data-knowledge-catalog={JSON.stringify(entries)} hidden></div>
<aside class="post-preview" data-post-preview role="dialog" aria-label="연결된 글 미리보기" aria-modal="false" hidden>
  <div class="post-preview__top">
    <span data-preview-kind></span>
    <button type="button" data-preview-close aria-label="미리보기 닫기">×</button>
  </div>
  <strong data-preview-title></strong>
  <p data-preview-description></p>
  <a data-preview-link href="/blog/">게시글 열기</a>
</aside>
<script is:inline>
  (() => {
    const catalog = document.querySelector("[data-knowledge-catalog]");
    const preview = document.querySelector("[data-post-preview]");
    if (!(catalog instanceof HTMLElement) || !(preview instanceof HTMLElement)) return;
    let entries;
    try { entries = JSON.parse(catalog.dataset.knowledgeCatalog || "[]"); } catch { return; }
    const byPath = new Map();
    for (const entry of entries) {
      if (!entry || !/^\/blog\/[^?#]+\/$/.test(entry.path)) continue;
      byPath.set(entry.path, entry);
      for (const alias of entry.aliases || []) {
        if (/^\/blog\/[^?#]+\/$/.test(alias)) byPath.set(alias, entry);
      }
    }
    const close = preview.querySelector("[data-preview-close]");
    const more = preview.querySelector("[data-preview-link]");
    const title = preview.querySelector("[data-preview-title]");
    const summary = preview.querySelector("[data-preview-description]");
    const kind = preview.querySelector("[data-preview-kind]");
    if (!(close instanceof HTMLButtonElement) || !(more instanceof HTMLAnchorElement)
      || !(title instanceof HTMLElement) || !(summary instanceof HTMLElement)
      || !(kind instanceof HTMLElement)) return;
    let current = null;
    let dismissTimer = 0;
    const hide = () => {
      window.clearTimeout(dismissTimer);
      preview.hidden = true;
      current = null;
    };
    const positionPreview = (anchor) => {
      const rect = anchor.getBoundingClientRect();
      const bounds = preview.getBoundingClientRect();
      preview.style.left = Math.max(8, Math.min(rect.left, window.innerWidth - bounds.width - 8)) + "px";
      preview.style.top = Math.max(8, Math.min(rect.bottom + 8, window.innerHeight - bounds.height - 8)) + "px";
    };
    const show = (anchor, entry) => {
      window.clearTimeout(dismissTimer);
      const label = (anchor.textContent || "").trim().replace(/\s+/g, " ");
      const isConcept = label.length > 1 && (
        label.toLocaleLowerCase() === entry.title.toLocaleLowerCase() ||
        entry.tags.some((tag) => tag.toLocaleLowerCase() === label.toLocaleLowerCase())
      );
      kind.textContent = isConcept ? "등록된 주제·개념 요약" : entry.category + " · 게시글 미리보기";
      title.textContent = entry.title;
      summary.textContent = entry.description;
      more.href = entry.path;
      preview.hidden = false;
      current = anchor;
      positionPreview(anchor);
    };
    const scheduleHide = () => {
      window.clearTimeout(dismissTimer);
      dismissTimer = window.setTimeout(() => {
        if (!preview.matches(":hover") && !preview.contains(document.activeElement)
          && current !== document.activeElement) hide();
      }, 250);
    };
    const anchors = document.querySelectorAll(
      ".post__content a[href], .post-learning-path a[href], .post-knowledge__backlinks a[href]"
    );
    for (const anchor of anchors) {
      if (!(anchor instanceof HTMLAnchorElement)) continue;
      let url;
      try { url = new URL(anchor.href); } catch { continue; }
      if (url.origin !== window.location.origin) continue;
      const entry = byPath.get(url.pathname.replace(/\/?$/, "/"));
      if (!entry || entry.path === window.location.pathname) continue;
      anchor.addEventListener("mouseenter", () => show(anchor, entry));
      anchor.addEventListener("focus", () => show(anchor, entry));
      anchor.addEventListener("mouseleave", scheduleHide);
      anchor.addEventListener("blur", scheduleHide);
      anchor.addEventListener("click", (event) => {
        if (event.pointerType === "touch" && (preview.hidden || current !== anchor)) {
          event.preventDefault();
          show(anchor, entry);
        }
      });
    }
    preview.addEventListener("mouseenter", () => window.clearTimeout(dismissTimer));
    preview.addEventListener("mouseleave", scheduleHide);
    close.addEventListener("click", () => {
      const back = current;
      back?.focus();
      hide();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !preview.hidden) {
        const back = current;
        back?.focus();
        hide();
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (!preview.hidden && !preview.contains(event.target) && event.target !== current) hide();
    });
    window.addEventListener("resize", hide);
    // Focus may scroll an anchor into view: reposition rather than dismissing
    // the tooltip in the same interaction that opened it.
    window.addEventListener("scroll", () => {
      if (!preview.hidden && current) positionPreview(current);
    }, { passive: true });
    // Only user-generated scrolling dismisses the popup; focus-triggered
    // browser scrolls must not immediately erase an accessible preview.
    window.addEventListener("wheel", hide, { passive: true });
    window.addEventListener("touchmove", hide, { passive: true });
  })();
</script>
