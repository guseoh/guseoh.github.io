<div class="post-reading-progress" aria-hidden="true">
  <span class="post-reading-progress__bar" data-reading-progress-bar></span>
</div>

<button
  type="button"
  class="post-back-to-top"
  data-post-back-to-top
  aria-label="페이지 맨 위로 이동"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
    <path d="m6 14 6-6 6 6"></path>
    <path d="M12 8v12"></path>
  </svg>
  <span>맨 위로</span>
</button>

<script is:inline>
  (() => {
    let initialized = false;
    let initAttempts = 0;

    const initReadingProgress = () => {
      if (initialized) return;

      const content = document.querySelector(".post__content");
      const bar = document.querySelector("[data-reading-progress-bar]");
      const backToTopButton = document.querySelector("[data-post-back-to-top]");
      if (!content || !bar || backToTopButton?.tagName !== "BUTTON") {
        initAttempts += 1;
        if (initAttempts <= 20) {
          window.setTimeout(initReadingProgress, 50);
        }
        return;
      }

      initialized = true;

      let frame = 0;
      let frameFallback = 0;
      const motionMedia = window.matchMedia("(prefers-reduced-motion: reduce)");

      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
      const prefersReducedMotion = () => motionMedia.matches;

      const getBounds = () => {
        const start = content.getBoundingClientRect().top + window.scrollY;
        const end = start + content.scrollHeight;
        const maxScroll = Math.max(start, end - window.innerHeight);
        return { start, end, maxScroll };
      };

      const readProgress = () => {
        const { start, maxScroll } = getBounds();
        if (maxScroll <= start) return 1;
        return clamp((window.scrollY - start) / (maxScroll - start), 0, 1);
      };

      // Reading locations are opt-in to restore (never auto-jump). Store only
      // position metadata on this device; no external service or account.
      const positionKey = `guseo:reading:position:${window.location.pathname}`;
      const lastKey = "guseo:reading:last";
      const maxAge = 30 * 24 * 60 * 60 * 1000;
      const panel = document.querySelector("[data-reading-resume]");
      const resumeLabel = panel?.querySelector("[data-reading-resume-label]");
      const resumeAction = panel?.querySelector("[data-reading-resume-action]");
      const clearAction = panel?.querySelector("[data-reading-resume-clear]");
      const title = document.querySelector(".post__header h1")?.textContent?.trim() ?? "";

      const clearPosition = () => {
        try {
          window.localStorage.removeItem(positionKey);
          const last = JSON.parse(window.localStorage.getItem(lastKey) || "null");
          if (last?.url === window.location.pathname) window.localStorage.removeItem(lastKey);
        } catch {
          // Storage may be disabled by browser privacy settings.
        }
      };

      const readPosition = () => {
        try {
          const saved = JSON.parse(window.localStorage.getItem(positionKey) || "null");
          if (saved && Number.isFinite(saved.fraction) && saved.fraction >= 0.08
            && saved.fraction < 0.97 && Number.isFinite(saved.updatedAt)
            && saved.updatedAt > Date.now() - maxAge && saved.updatedAt <= Date.now()) {
            return saved;
          }
        } catch {
          // Ignore invalid or unavailable saved state.
        }
        return null;
      };

      const stored = readPosition();
      if (stored && panel instanceof HTMLElement
        && resumeLabel instanceof HTMLElement && resumeAction instanceof HTMLButtonElement) {
        resumeAction.addEventListener("click", () => {
          panel.hidden = true;
          const { start, maxScroll } = getBounds();
          window.scrollTo({
            top: start + (maxScroll - start) * stored.fraction,
            behavior: prefersReducedMotion() ? "auto" : "smooth"
          });
        });

        // Let the browser restore session history or an anchor first.
        window.setTimeout(() => {
          if (!window.location.hash && window.scrollY < getBounds().start + 40) {
            resumeLabel.textContent = `약 ${Math.round(stored.fraction * 100)}% 읽은 위치가 있습니다.`;
            panel.hidden = false;
          }
        }, 160);
      }

      if (clearAction instanceof HTMLButtonElement && panel instanceof HTMLElement) {
        clearAction.addEventListener("click", () => {
          clearPosition();
          panel.hidden = true;
        });
      }

      const savePosition = () => {
        const fraction = readProgress();
        if (fraction >= 0.97) {
          clearPosition();
          return;
        }
        if (fraction < 0.08 || !title) return;
        const entry = { fraction: Math.round(fraction * 1000) / 1000, updatedAt: Date.now() };
        try {
          window.localStorage.setItem(positionKey, JSON.stringify(entry));
          window.localStorage.setItem(lastKey, JSON.stringify({
            ...entry,
            url: window.location.pathname,
            title
          }));
        } catch {
          // Private browsing or storage quotas must not break the page.
        }
      };

      const update = () => {
        frame = 0;
        if (frameFallback) {
          window.clearTimeout(frameFallback);
          frameFallback = 0;
        }
        bar.style.transform = `scaleX(${readProgress()})`;
        backToTopButton.classList.toggle("is-visible", window.scrollY > 320);
      };

      const scheduleUpdate = () => {
        if (frame || frameFallback) return;
        frame = window.requestAnimationFrame(update);
        frameFallback = window.setTimeout(() => {
          if (frame) {
            window.cancelAnimationFrame(frame);
            frame = 0;
          }
          update();
        }, 120);
      };

      const scrollToTop = () => {
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion() ? "auto" : "smooth"
        });
      };

      // Native buttons already synthesize click for Enter and Space.
      backToTopButton.addEventListener("click", scrollToTop);
      let saveTimer = 0;
      window.addEventListener("scroll", () => {
        scheduleUpdate();
        if (!saveTimer) {
          saveTimer = window.setTimeout(() => {
            saveTimer = 0;
            savePosition();
          }, 650);
        }
      }, { passive: true });
      window.addEventListener("pagehide", () => {
        if (saveTimer) window.clearTimeout(saveTimer);
        savePosition();
      });
      window.addEventListener("resize", scheduleUpdate);
      window.addEventListener("load", scheduleUpdate);

      if ("ResizeObserver" in window) {
        const observer = new ResizeObserver(scheduleUpdate);
        observer.observe(content);
      }

      for (const image of content.querySelectorAll("img")) {
        if ("complete" in image && !image.complete) {
          image.addEventListener("load", scheduleUpdate, { once: true });
        }
      }

      scheduleUpdate();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initReadingProgress, { once: true });
    } else {
      initReadingProgress();
    }
  })();
</script>
