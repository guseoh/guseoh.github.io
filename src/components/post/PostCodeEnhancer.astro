<script is:inline>
  (() => {
    const blocks = Array.from(document.querySelectorAll(".post pre"));
    if (blocks.length === 0) return;

    const languageLabels = new Map([
      ["java", "Java"],
      ["js", "JavaScript"],
      ["javascript", "JavaScript"],
      ["ts", "TypeScript"],
      ["typescript", "TypeScript"],
      ["sql", "SQL"],
      ["bash", "Bash"],
      ["sh", "Bash"],
      ["yaml", "YAML"],
      ["yml", "YAML"],
      ["html", "HTML"],
      ["css", "CSS"],
      ["json", "JSON"],
      ["xml", "XML"],
      ["properties", "Properties"],
      ["text", "Code"],
      ["plaintext", "Code"]
    ]);

    const getLanguageKey = (pre) => {
      const fromData = pre.dataset.language || "";
      if (fromData.trim().length > 0) return fromData;

      const code = pre.querySelector("code");
      const className = `${pre.className} ${code?.className ?? ""}`;
      const match = className.match(/language-([A-Za-z0-9_-]+)/);
      return match?.[1] ?? "";
    };

    const getLanguageLabel = (pre) => {
      const key = getLanguageKey(pre).trim().toLowerCase();
      return languageLabels.get(key) ?? (key.length > 0 ? key[0].toUpperCase() + key.slice(1) : "Code");
    };

    const getMetaValue = (pre, code, marker, key) => marker?.dataset[key] || pre.dataset[key] || code?.dataset[key] || "";

    const expandHighlightedLines = (value) => {
      const lines = new Set();

      for (const token of value.split(",")) {
        const trimmed = token.trim();
        if (!trimmed) continue;

        const [startValue, endValue] = trimmed.split("-");
        const start = Number(startValue);
        const end = endValue ? Number(endValue) : start;

        if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || end < start) continue;

        for (let line = start; line <= end; line += 1) {
          lines.add(line);
        }
      }

      return lines;
    };

    const applyLineMetadata = (wrapper, pre, code, marker) => {
      const showLineNumbers = getMetaValue(pre, code, marker, "showLineNumbers") === "true";
      const highlightedLines = expandHighlightedLines(getMetaValue(pre, code, marker, "highlightLines"));
      const lines = Array.from(code?.querySelectorAll(":scope > .line") ?? []);

      if (showLineNumbers) {
        wrapper.classList.add("code-block--line-numbers");
        pre.classList.add("has-line-numbers");
      }

      if (highlightedLines.size > 0) {
        wrapper.classList.add("code-block--highlight-lines");
      }

      lines.forEach((line, lineIndex) => {
        if (!(line instanceof HTMLElement)) return;

        const lineNumber = lineIndex + 1;
        if (showLineNumbers) {
          line.dataset.lineNumber = String(lineNumber);
        }

        if (highlightedLines.has(lineNumber)) {
          line.classList.add("is-highlighted");
        }
      });
    };

    for (const [index, pre] of blocks.entries()) {
      if (!(pre instanceof HTMLPreElement) || pre.parentElement?.classList.contains("code-block") || pre.closest(".learning-block")) continue;
      const code = pre.querySelector("code");
      const metaMarker = pre.previousElementSibling instanceof HTMLElement && pre.previousElementSibling.classList.contains("code-block-meta")
        ? pre.previousElementSibling
        : null;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";
      const tabGroup = getMetaValue(pre, code, metaMarker, "codeTabGroup").trim();
      const tabTitle = getMetaValue(pre, code, metaMarker, "codeTabTitle").trim();
      const diffState = getMetaValue(pre, code, metaMarker, "codeDiffState").trim();
      if (tabGroup) wrapper.dataset.codeTabGroup = tabGroup;
      if (tabTitle) wrapper.dataset.codeTabTitle = tabTitle;
      if (diffState === "before" || diffState === "after") {
        wrapper.classList.add(`code-block--diff-${diffState}`);
      }
      pre.parentNode?.insertBefore(wrapper, pre);

      const header = document.createElement("div");
      header.className = "code-block__header";

      const meta = document.createElement("div");
      meta.className = "code-block__meta";

      const language = document.createElement("span");
      language.className = "code-block__language";
      language.textContent = getLanguageLabel(pre);
      meta.append(language);

      const codeTitle = getMetaValue(pre, code, metaMarker, "codeTitle").trim();
      // Text diagrams opt into a semantic presentation without changing Shiki or code copy.
      const isDiagram = getLanguageKey(pre).trim().toLowerCase() === "diagram";
      if (isDiagram) {
        wrapper.classList.add("code-block--diagram");
        wrapper.setAttribute("role", "group");
        wrapper.setAttribute("aria-label", "본문 개념도");
        language.textContent = "개념도";
      }
      if (codeTitle.length > 0) {
        const title = document.createElement("span");
        title.className = "code-block__title";
        title.textContent = codeTitle;
        title.title = codeTitle;
        meta.append(title);
      }
      if (diffState === "before" || diffState === "after") {
        const badge = document.createElement("span");
        badge.className = "code-block__diff-label";
        badge.textContent = diffState === "before" ? "수정 전" : "수정 후";
        meta.append(badge);
      }

      const button = document.createElement("button");
      button.type = "button";
      button.className = "code-copy-button";
      const originalLabel = isDiagram ? "개념도 텍스트 복사" : "코드 블록 복사";
      const iconNamespace = "http://www.w3.org/2000/svg";
      const makeIcon = (name) => {
        const svg = document.createElementNS(iconNamespace, "svg");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.setAttribute("width", "17");
        svg.setAttribute("height", "17");
        svg.setAttribute("fill", "none");
        svg.setAttribute("stroke", "currentColor");
        svg.setAttribute("stroke-width", "1.8");
        svg.setAttribute("stroke-linecap", "round");
        svg.setAttribute("stroke-linejoin", "round");
        svg.setAttribute("aria-hidden", "true");
        const shapes = name === "copy" ? [
          ["rect", { x: "8", y: "8", width: "13", height: "13", rx: "2" }],
          ["path", { d: "M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" }]
        ] : name === "check"
          ? [["path", { d: "M20 6 9 17l-5-5" }]]
          : [["path", { d: "M12 9v4m0 4h.01M10.3 3.9 2.4 18a2 2 0 0 0 1.75 3h15.7a2 2 0 0 0 1.75-3L13.7 3.9a2 2 0 0 0-3.4 0Z" }]];
        shapes.forEach(([tag, attrs]) => {
          const node = document.createElementNS(iconNamespace, tag);
          Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
          svg.append(node);
        });
        return svg;
      };
      const setCopyState = (state) => {
        const labels = {
          idle: originalLabel,
          copied: "복사됨",
          selected: "복사 실패: 직접 선택해 주세요"
        };
        const label = labels[state] || originalLabel;
        button.replaceChildren(makeIcon(state === "idle" ? "copy" : state === "copied" ? "check" : "warning"));
        button.dataset.copyState = state;
        button.dataset.tooltip = label;
        button.setAttribute("aria-label", label);
        button.title = label;
      };
      let restoreCopyStateTimer = null;
      const scheduleCopyReset = () => {
        if (restoreCopyStateTimer !== null) window.clearTimeout(restoreCopyStateTimer);
        restoreCopyStateTimer = window.setTimeout(() => {
          setCopyState("idle");
          restoreCopyStateTimer = null;
        }, 1400);
      };
      setCopyState("idle");

      const status = document.createElement("span");
      status.id = `code-copy-status-${index}`;
      status.className = "sr-only";
      status.setAttribute("aria-live", "polite");
      status.setAttribute("aria-atomic", "true");
      button.setAttribute("aria-describedby", status.id);

      const lineElements = code?.querySelectorAll(":scope > .line");
      const lineCount = lineElements?.length || (code?.textContent ?? pre.textContent ?? "").split(/\r?\n/).length;
      if (lineCount > 20) {
        wrapper.classList.add("code-block--collapsible", "is-collapsed");
        if (!pre.id) pre.id = `code-content-${index}`;

        const toggle = document.createElement("button");
        toggle.type = "button";
        toggle.className = "code-block__expand";
        toggle.setAttribute("aria-controls", pre.id);
        toggle.setAttribute("aria-expanded", "false");
        toggle.textContent = "전체 보기";
        toggle.addEventListener("click", () => {
          const expanding = wrapper.classList.contains("is-collapsed");
          wrapper.classList.toggle("is-collapsed", !expanding);
          toggle.setAttribute("aria-expanded", String(expanding));
          toggle.textContent = expanding ? "접기" : "전체 보기";
        });

        const actions = document.createElement("div");
        actions.className = "code-block__actions";
        actions.append(toggle, button);
        header.append(meta, actions, status);
      } else {
        header.append(meta, button, status);
      }

      wrapper.append(header, pre);
      applyLineMetadata(wrapper, pre, code, metaMarker);
      metaMarker?.remove();

      const copyText = async (text) => {
        if (window.navigator?.clipboard && window.isSecureContext) {
          await window.navigator.clipboard.writeText(text);
          return "copied";
        }

        if (typeof document.createElement !== "function") {
          return "selected";
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.setAttribute("readonly", "true");
        textarea.style.position = "fixed";
        textarea.style.top = "-1000px";
        textarea.style.left = "-1000px";
        document.body.append(textarea);
        textarea.select();

        const execCopy = document["exec" + "Command"];
        const copied = typeof execCopy === "function" && execCopy.call(document, "copy");
        textarea.remove();

        if (copied) return "copied";
        const selection = window.getSelection();
        if (selection) {
          const range = document.createRange();
          range.selectNodeContents(code ?? pre);
          selection.removeAllRanges();
          selection.addRange(range);
        }
        return "selected";
      };

      const getCodeText = () => {
        const code = pre.querySelector("code");
        const lines = Array.from(code?.querySelectorAll(":scope > .line") ?? []);

        if (lines.length > 0) {
          return lines.map((line) => line.textContent ?? "").join("\n");
        }

        return code?.textContent ?? pre.textContent ?? "";
      };

      const announce = (message) => {
        if (status.textContent === message) {
          status.textContent = "";
          window.setTimeout(() => {
            status.textContent = message;
          }, 20);
          return;
        }

        status.textContent = message;
      };

      button.addEventListener("click", async () => {
        try {
          const result = await copyText(getCodeText());
          setCopyState(result === "copied" ? "copied" : "selected");
          announce(result === "copied"
            ? "코드가 복사되었습니다."
            : "코드를 선택했습니다. 직접 복사해 주세요.");
          scheduleCopyReset();
        } catch {
          setCopyState("selected");
          announce("코드를 복사하지 못했습니다. 직접 선택해서 복사해 주세요.");
          scheduleCopyReset();
        }
      });
    }

    // A contiguous set of fenced code blocks with the same tabGroup forms one
    // accessible tabs widget. Ordinary code fences and code copy stay unchanged.
    const candidates = Array.from(document.querySelectorAll(".post__content .code-block[data-code-tab-group]"));
    const used = new Set();
    let groupId = 0;
    for (const first of candidates) {
      if (used.has(first)) continue;
      const name = first.dataset.codeTabGroup;
      const siblings = [first];
      let next = first.nextElementSibling;
      while (next?.classList.contains("code-block") && next.dataset.codeTabGroup === name) {
        siblings.push(next);
        next = next.nextElementSibling;
      }
      siblings.forEach((node) => used.add(node));
      if (siblings.length < 2) continue;
      const container = document.createElement("section");
      container.className = "code-tab-group";
      container.setAttribute("aria-label", "코드 예제 탭");
      const tabs = document.createElement("div");
      tabs.className = "code-tab-group__tabs";
      tabs.setAttribute("role", "tablist");
      tabs.setAttribute("aria-label", "코드 버전");
      const buttons = [];
      const selectTab = (selected, moveFocus = false) => {
        siblings.forEach((panel, i) => {
          const active = i === selected;
          panel.hidden = !active;
          buttons[i].setAttribute("aria-selected", String(active));
          buttons[i].tabIndex = active ? 0 : -1;
        });
        if (moveFocus) buttons[selected].focus();
      };
      const id = groupId++;
      siblings.forEach((panel, i) => {
        const tab = document.createElement("button");
        tab.type = "button";
        tab.className = "code-tab-group__tab";
        const displayName = panel.dataset.codeTabTitle || (
          panel.classList.contains("code-block--diff-before") ? "수정 전"
            : panel.classList.contains("code-block--diff-after") ? "수정 후" : "예제 " + (i + 1)
        );
        tab.textContent = displayName;
        tab.id = `code-group-${id}-tab-${i}`;
        panel.id = `code-group-${id}-panel-${i}`;
        tab.setAttribute("role", "tab");
        tab.setAttribute("aria-controls", panel.id);
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tab.id);
        tab.addEventListener("click", () => selectTab(i));
        tab.addEventListener("keydown", (event) => {
          let target = -1;
          if (event.key === "ArrowRight") target = (i + 1) % siblings.length;
          if (event.key === "ArrowLeft") target = (i - 1 + siblings.length) % siblings.length;
          if (event.key === "Home") target = 0;
          if (event.key === "End") target = siblings.length - 1;
          if (target < 0) return;
          event.preventDefault();
          selectTab(target, true);
        });
        buttons.push(tab);
        tabs.append(tab);
      });
      first.parentNode?.insertBefore(container, first);
      container.append(tabs, ...siblings);

      // A bounded LCS marks only changed lines, without altering the code text
      // used by the existing Copy button.
      const before = siblings.find((panel) => panel.classList.contains("code-block--diff-before"));
      const after = siblings.find((panel) => panel.classList.contains("code-block--diff-after"));
      if (before && after) {
        const beforeLines = Array.from(before.querySelectorAll("code > .line"));
        const afterLines = Array.from(after.querySelectorAll("code > .line"));
        const a = beforeLines.map((line) => line.textContent ?? "");
        const b = afterLines.map((line) => line.textContent ?? "");
        if (a.length > 0 && b.length > 0 && a.length <= 250 && b.length <= 250) {
          const dp = Array.from({ length: a.length + 1 }, () => new Uint16Array(b.length + 1));
          for (let i = a.length - 1; i >= 0; i -= 1) {
            for (let j = b.length - 1; j >= 0; j -= 1) {
              dp[i][j] = a[i] === b[j] ? 1 + dp[i + 1][j + 1] : Math.max(dp[i + 1][j], dp[i][j + 1]);
            }
          }
          let i = 0;
          let j = 0;
          while (i < a.length && j < b.length) {
            if (a[i] === b[j]) { i += 1; j += 1; }
            else if (dp[i + 1][j] >= dp[i][j + 1]) {
              beforeLines[i++].classList.add("is-removed");
            } else {
              afterLines[j++].classList.add("is-added");
            }
          }
          while (i < a.length) beforeLines[i++].classList.add("is-removed");
          while (j < b.length) afterLines[j++].classList.add("is-added");
        }
      }
      selectTab(0);
    }
  })();
</script>
