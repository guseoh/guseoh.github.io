---
import type { CollectionEntry } from "astro:content";
import { getPostDescription, getPostPath } from "../../utils/posts";
import type { Relationship } from "../../utils/postRelations";

interface Props {
  current: CollectionEntry<"blog">;
  incoming: CollectionEntry<"blog">[];
  connections: Relationship[];
}

const { current, incoming, connections } = Astro.props as Props;
const kinds: Record<Relationship["kind"], string> = {
  previous: "이전 학습 단계",
  next: "다음 학습 단계",
  linked: "본문에서 참조한 글"
};
---
{(incoming.length > 0 || connections.length > 0) && (
  <section class="post-knowledge" aria-labelledby="post-knowledge-title">
    <div class="post-knowledge__heading">
      <span class="post-related__label">Knowledge connections</span>
      <h2 id="post-knowledge-title">실제 글 연결</h2>
      <p>게시글에 명시된 링크와 학습 순서만 연결합니다. 관계를 선택하면 글의 요약을 확인할 수 있습니다.</p>
    </div>

    {connections.length > 0 && (
      <div class="post-knowledge__explorer">
        <div class="post-knowledge__origin" aria-label="현재 읽는 글">
          <span class="post-knowledge__origin-label">현재 읽는 글</span>
          <strong>{current.data.title}</strong>
          <span class="post-knowledge__count">확인된 연결 {connections.length}개</span>
        </div>
        <ol class="post-knowledge__cards" aria-label="연결된 글 탐색">
          {connections.map(({ post, kind }, index) => (
            <li>
              <details class="post-knowledge__card" name="post-knowledge-connections" open={index === 0}>
                <summary>
                  <span class="post-knowledge__kind">{kinds[kind]}</span>
                  <span class="post-knowledge__title">{post.data.title}</span>
                  <span class="post-knowledge__chevron" aria-hidden="true"></span>
                </summary>
                <div class="post-knowledge__detail">
                  <p>{getPostDescription(post)}</p>
                  <a href={getPostPath(post)}>게시글 읽기 <span aria-hidden="true">↗</span></a>
                </div>
              </details>
            </li>
          ))}
        </ol>
      </div>
    )}

    {incoming.length > 0 && (
      <div class="post-knowledge__backlinks">
        <h3>이 글을 참조한 글 <span>{incoming.length}</span></h3>
        <ul>{incoming.map((post) => <li><a href={getPostPath(post)}>{post.data.title}</a></li>)}</ul>
      </div>
    )}
  </section>
)}
