---
import CategoryIcon from "./CategoryIcon.astro";
import { normalizeCategory } from "../utils/categories";
import { formatTagName, getTagHref, resolveTagSlug } from "../utils/tags";

interface Props {
  category?: string;
  tags?: string[];
  maxTags?: number;
}

const { category = "Uncategorized", tags = [], maxTags = tags.length } = Astro.props as Props;
const categoryName = category.trim() || "Uncategorized";
const categorySlug = normalizeCategory(categoryName);
const uniqueTags = tags.filter((tag) => resolveTagSlug(tag) !== categorySlug);
const visibleTags = uniqueTags.slice(0, maxTags);
const hiddenTagCount = Math.max(0, uniqueTags.length - visibleTags.length);
---

<div class="badge-group">
  <a class="badge badge--category" href={`/categories/${normalizeCategory(categoryName)}/`}>
    <CategoryIcon category={categoryName} />
    <span>{categoryName}</span>
  </a>
  {visibleTags.map((tag) => (
    <a class="badge badge--tag" href={getTagHref(tag)}>#{formatTagName(tag)}</a>
  ))}
  {hiddenTagCount > 0 && <span class="badge badge--muted">+{hiddenTagCount}</span>}
</div>
