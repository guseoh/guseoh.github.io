---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Sidebar from "../components/layout/Sidebar.astro";
import LayoutScripts from "../components/layout/LayoutScripts.astro";
import { SITE } from "../config/site";
import { serializeInlineJson } from "../utils/serializeInlineJson";
import { getPublishedPosts } from "../utils/content/posts";
import { normalizeCategory, buildCategoryHierarchy } from "../utils/categories";
import { buildArchiveTagSummary } from "../utils/tags";
import {
  SIDEBAR_TAG_LIMIT,
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_OG_IMAGE,
  SITE_TITLE,
  SITE_URL
} from "../utils/posts";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  minimalHome?: boolean;
  wideContent?: boolean;
  publishedTime?: string;
  updatedTime?: string;
  type?: "website" | "article";
  structuredData?: unknown;
  currentCategory?: string;
  canonicalUrl?: string;
  refreshUrl?: string;
  robots?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = SITE_OG_IMAGE,
  minimalHome = false,
  wideContent = false,
  publishedTime,
  updatedTime,
  type = "website",
  structuredData,
  currentCategory: currentCategoryName,
  canonicalUrl: canonicalUrlOverride,
  refreshUrl,
  robots
} = Astro.props;

const posts = await getPublishedPosts();
// The home layout does not render Sidebar. Avoid taxonomy aggregation there.
const sidebarNavigation = minimalHome ? [] : buildCategoryHierarchy(posts);
const tagSummary = minimalHome ? [] : buildArchiveTagSummary(posts).slice(0, SIDEBAR_TAG_LIMIT);
// The header only needs to know whether published Book/Series content exists.
const hasPublishedBooks = posts.some((post) => Boolean(post.data.book?.trim()));
const hasPublishedSeries = posts.some((post) => Boolean(post.data.series?.trim()));
const siteUrl = Astro.site ?? new URL(SITE_URL);
const canonicalUrl = canonicalUrlOverride
  ? new URL(canonicalUrlOverride, siteUrl).toString()
  : new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image, siteUrl).toString();
const imageType = /\.svg(?:\?|$)/i.test(ogImageUrl)
  ? "image/svg+xml"
  : /\.png(?:\?|$)/i.test(ogImageUrl)
    ? "image/png"
    : /\.(?:jpe?g)(?:\?|$)/i.test(ogImageUrl)
      ? "image/jpeg"
      : undefined;
const isStandardOgImage = image === SITE_OG_IMAGE || /^\/og\/.+\.png$/.test(image);
const ogAltText = type === "article" ? `${title} 공유 이미지` : `${SITE_TITLE} 대표 이미지`;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const routeCategory = currentPath.startsWith("/categories/") ? currentPath.split("/")[2] ?? "" : "";
const currentCategory = currentCategoryName?.trim()
  ? normalizeCategory(currentCategoryName)
  : routeCategory;
const currentTag = currentPath.startsWith("/tags/") ? currentPath.split("/")[2] ?? "" : "";


---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {refreshUrl && <meta http-equiv="refresh" content={`0;url=${new URL(refreshUrl, siteUrl).toString()}`} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={new URL("/rss.xml", siteUrl).toString()} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={ogAltText} />
    {isStandardOgImage && <meta property="og:image:width" content="1200" />}
    {isStandardOgImage && <meta property="og:image:height" content="630" />}
    {imageType && <meta property="og:image:type" content={imageType} />}
    {type === "article" && <meta property="article:author" content={SITE_AUTHOR} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {structuredData && <script is:inline type="application/ld+json" set:html={serializeInlineJson(structuredData)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAltText} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const themeModes = ["light", "dark", "system", "planner"];
        let stored = null;

        try {
          stored = localStorage.getItem("theme");
        } catch {
        }

        const mode = themeModes.includes(stored) ? stored : "system";
        const theme = mode === "planner"
          ? "dark"
          : mode === "system"
            ? (systemDark ? "dark" : "light")
            : mode;
        document.documentElement.setAttribute("data-theme", theme);
        document.documentElement.setAttribute("data-theme-mode", mode);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <script is:inline>
      (() => {
        try {
          const desktop = window.matchMedia("(min-width: 981px)").matches;
          const stored = localStorage.getItem("blog-left-sidebar-collapsed");
          const collapsed = stored === null ? true : stored === "true";

          if (desktop && collapsed) {
            document.documentElement.classList.add("left-sidebar-collapsed");
          }
        } catch {
          document.documentElement.classList.remove("left-sidebar-collapsed");
        }
      })();
    </script>
  </head>
  <body class:list={[minimalHome && "page-home-simple"]}>
    <a class="skip-link" href="#main-content">본문으로 건너뛰기</a>
    <div class:list={["site-shell", wideContent && "site-shell--wide"]}>
      <Header
        currentPath={currentPath}
        hasPublishedBooks={hasPublishedBooks}
        hasPublishedSeries={hasPublishedSeries}
      />

      <div class:list={["site-layout", minimalHome && "site-layout--minimal", wideContent && "site-layout--wide"]}>
        {
          !minimalHome && (
            <Sidebar
              categoryHierarchy={sidebarNavigation}
              tagSummary={tagSummary}
              totalPostCount={posts.length}
              currentCategory={currentCategory}
              currentTag={currentTag}
              currentPath={currentPath}
            />
          )
        }

        <div class="site-content">
          <main id="main-content" class="site-main" tabindex="-1">
            <slot />
          </main>
        </div>
      </div>
    </div>

    <LayoutScripts />
  </body>
</html>
